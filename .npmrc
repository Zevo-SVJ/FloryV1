# Refuse to install on a Node version Next.js cannot run on.
#
# Next 16 requires Node >= 20.9. Without this, an older Node installs happily
# and then `next dev` fails with a syntax or module-resolution error several
# layers down, which reads as "the project is broken" rather than "upgrade
# Node". `engines` in package.json is only a warning until this line makes it
# an error, at install time, where it is cheap to act on.
engine-strict=true
