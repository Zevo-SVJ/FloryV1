# ShowMe — environment
#
# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Never commit .env.local.

# ── Supabase ────────────────────────────────────────────────────────────────
# Both are safe in the browser: the anon key only grants what Row Level
# Security allows. Every table in this project has RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
# The canonical origin, used for absolute URLs in metadata and auth redirects.
# Leave unset locally; Vercel sets VERCEL_URL, which is used as a fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Storage ─────────────────────────────────────────────────────────────────
# Uploaded images go to the `page-media` bucket, created by
# supabase/migrations/20260103000001_editor_and_media.sql. No extra variable is
# needed: the bucket is reached with the anon key above, and its policies allow
# a creator to write only inside a folder named after their own user id.

# ── Not needed yet ──────────────────────────────────────────────────────────
# The service-role key bypasses Row Level Security. It is NOT required by this
# phase and must never be exposed to the browser or prefixed with NEXT_PUBLIC_.
# It will be added when analytics ingestion (phase 6) and Stripe webhooks
# (phase 7) need to write rows that no user is allowed to write.
# SUPABASE_SERVICE_ROLE_KEY=
