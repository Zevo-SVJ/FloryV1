# Blink — configuration
#
# Every value here is optional. Without them Blink still runs: it shows the
# sample report, keeps history on the device, and says so in the interface.
# Nothing is simulated in place of a missing capability.

# ── Analysis ────────────────────────────────────────────────────────────────
# Without this, uploads are refused with an explanation and only the sample
# report is available. With it, /api/analyze reads real screenshots.
ANTHROPIC_API_KEY=

# Optional. Point at a gateway or proxy instead of the default endpoint.
ANTHROPIC_BASE_URL=

# Optional. Defaults to claude-opus-5.
BLINK_MODEL=

# Optional guard rails.
BLINK_MAX_UPLOAD_BYTES=8388608
BLINK_RATE_LIMIT=12
BLINK_RATE_WINDOW_MS=600000
BLINK_LOG_LEVEL=info

# ── Accounts and history ────────────────────────────────────────────────────
# All six are required together, or accounts are switched off and reports are
# kept in the browser instead. These values are public by design — access is
# enforced by the rules in firestore.rules, not by keeping them secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Instagram ───────────────────────────────────────────────────────────────
# There is one provider today and it is switched off: `unavailable`. When a real
# Graph API provider is registered in src/lib/instagram/index.ts, name it here.
INSTAGRAM_PROVIDER=unavailable
